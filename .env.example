# Gallery — env vars (copy to .env; never commit .env)
#
# YouTube sermons (/sermons): required for playlist auto-sync
YOUTUBE_API_KEY=
# Optional: English channel handle for live banner (default: rolccindia)
# YOUTUBE_CHANNEL_HANDLE=rolccindia

# Instagram gallery (/gallery): required when instagram.enabled is true in gallery-config.json
# See docs/gallery-setup.md for the full Meta setup walkthrough
# INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_USER_ID=
